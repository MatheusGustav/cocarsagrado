# Segurança (tudo que sai do Pages). CSP montada do inventário real:
# - script: self + supabase-js do jsdelivr; 'unsafe-inline' é obrigatório
#   enquanto o site usa onclick= inline (ainda barra script de domínio alheio)
# - style/font: Google Fonts; connect: Supabase REST/Functions + Realtime (wss)
# - img/media: storage do Supabase + blob:/data: (gravador, previews);
#   img também do cdn.cocarsagrado.com.br (R2 do catálogo — subdomínio ≠ 'self')
# - frame 'self': o painel abre documento-verde.html num iframe
# - microphone=(self): gravador de áudios do painel
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://demxedudbislzausvhwx.supabase.co https://cdn.cocarsagrado.com.br; media-src 'self' blob: https://demxedudbislzausvhwx.supabase.co; connect-src 'self' https://demxedudbislzausvhwx.supabase.co wss://demxedudbislzausvhwx.supabase.co; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000

/*.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

# no-cache (e não max-age=0): o Browser Cache TTL da zona Cloudflare (4h)
# sobrepõe qualquer max-age menor, mas respeita no-cache — o navegador
# revalida via ETag a cada visita (304 se não mudou). Dispensa bump de ?v=.
/*.css
  Cache-Control: no-cache, must-revalidate

/*.js
  Cache-Control: no-cache, must-revalidate

/data/*
  Cache-Control: no-cache, must-revalidate

# Aceite dos termos por link (token no query string): página privada,
# fora dos buscadores — nas duas formas de URL (limpa e .html)
/aceite
  X-Robots-Tag: noindex

/aceite.html
  X-Robots-Tag: noindex

# Descadastro do lembrete por e-mail (token no query string): mesma
# história — link privado, fora dos buscadores
/descadastro
  X-Robots-Tag: noindex

/descadastro.html
  X-Robots-Tag: noindex


# Imagens mudam raramente — 7 dias (necessário com Browser Cache TTL
# da zona em "Respect Existing Headers", senão ficariam sem cache)
/images/*
  Cache-Control: public, max-age=604800

/images/logo3-192.png
  Cache-Control: public, max-age=31536000, immutable

/images/logo3.png
  Cache-Control: public, max-age=31536000, immutable
